# Copy this file to .env and fill in real values. Never commit .env.
# (.env is listed in .gitignore, so git ignores it automatically.)

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://tradex:change_me@localhost:5432/tradex

# --- Market data ----------------------------------------------------------------
# sample = synthetic test data (clearly labelled, works without any account)
# groww  = real data from the Groww Trade API
DATA_PROVIDER=sample

# Groww login: fill in ONE of the two options (get them at https://groww.in/trade-api/api-keys)
# Option 1: API key + secret (Groww asks you to approve the key once a day)
GROWW_API_KEY=
GROWW_API_SECRET=
# Option 2: TOTP token + TOTP secret (no daily approval)
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=

# What to collect
# Indices and F&O stocks to track (the 12-instrument pool). Symbols Groww doesn't list are skipped.
UNDERLYINGS=NIFTY,BANKNIFTY,FINNIFTY,HDFCBANK,ICICIBANK,SBIN,AXISBANK,INFY,TCS,RELIANCE,BHARTIARTL,LT
TIMEFRAMES=1d,1h
BACKFILL_DAYS_1D=1825
BACKFILL_DAYS_1H=365
FUTURES_EXPIRIES_TO_TRACK=2

# --- Telegram alerts ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Collector (always-on process) -----------------------------------------------------
COLLECTOR_INTERVAL_MINUTES=5

# --- API ---------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
